create database ArtConnect;
use artconnect;
CREATE TABLE Artist (
    id_artist INT PRIMARY KEY,
    Name VARCHAR(100),
    Bio TEXT,
    Birth_year INT,
    contact_mail VARCHAR(100),
    phone VARCHAR(20),
    city VARCHAR(50),
    website VARCHAR(100),
    is_active BOOLEAN
);

CREATE TABLE Artwork (
    id_artwork INT PRIMARY KEY,
    id_artist INT,
    Title VARCHAR(150),
    creation_year INT,
    type VARCHAR(50),
    medium VARCHAR(50),
    description TEXT,
    dimensions VARCHAR(50),
    price DECIMAL(10,2),
    status VARCHAR(50),
    FOREIGN KEY (id_artist) REFERENCES Artist(id_artist)
);

CREATE TABLE tags (
    id_artwork INT,
    id_tag INT,
    PRIMARY KEY (id_artwork, id_tag),
    FOREIGN KEY (id_artwork) REFERENCES Artwork(id_artwork)
);

CREATE TABLE Artworktag (
    id_tag INT PRIMARY KEY,
    tag_name VARCHAR(50)
);

CREATE TABLE Gallery (
    id_gallery INT PRIMARY KEY,
    name VARCHAR(100),
    address VARCHAR(150),
    ownername VARCHAR(100),
    opening_hours VARCHAR(100),
    contact_phone VARCHAR(20),
    rating FLOAT,
    website VARCHAR(100)
);

CREATE TABLE Exhibition (
    id_exhibition INT PRIMARY KEY,
    id_gallery INT,
    Title VARCHAR(150),
    start_date DATE,
    end_date DATE,
    description TEXT,
    curator_name VARCHAR(100),
    theme VARCHAR(100),
    FOREIGN KEY (id_gallery) REFERENCES Gallery(id_gallery)
);

CREATE TABLE shows (
    id_exhibition INT,
    id_artwork INT,
    PRIMARY KEY (id_exhibition, id_artwork),
    FOREIGN KEY (id_exhibition) REFERENCES Exhibition(id_exhibition),
    FOREIGN KEY (id_artwork) REFERENCES Artwork(id_artwork)
);

CREATE TABLE Reviews (
    id_review INT PRIMARY KEY,
    id_member INT,
    id_artwork INT,
    rating INT,
    comment TEXT,
    review_date DATE,
    FOREIGN KEY (id_artwork) REFERENCES Artwork(id_artwork)
);

CREATE TABLE CommunityMember (
    id_member INT PRIMARY KEY,
    Name VARCHAR(100),
    Email VARCHAR(100),
    BirthYear INT,
    phone VARCHAR(20),
    city VARCHAR(50),
    favDiscipline VARCHAR(50),
    Membership_type VARCHAR(50)
);

CREATE TABLE Discipline (
    id_discipline INT PRIMARY KEY,
    name VARCHAR(100)
);

CREATE TABLE Chooses (
    id_member INT,
    id_discipline INT,
    PRIMARY KEY (id_member, id_discipline),
    FOREIGN KEY (id_member) REFERENCES CommunityMember(id_member),
    FOREIGN KEY (id_discipline) REFERENCES Discipline(id_discipline)
);

CREATE TABLE workshop (
    id_workshop INT PRIMARY KEY,
    id_instructor INT,
    title VARCHAR(150),
    dates VARCHAR(100),
    duration_minutes INT,
    max_participant INT,
    price DECIMAL(10,2),
    location VARCHAR(100),
    description TEXT,
    level VARCHAR(50),
    FOREIGN KEY (id_instructor) REFERENCES Artist(id_artist)
);

CREATE TABLE Books (
    id_booking INT PRIMARY KEY,
    id_member INT,
    id_workshop INT,
    Booking_date DATE,
    Payment_Status VARCHAR(50),
    FOREIGN KEY (id_member) REFERENCES CommunityMember(id_member),
    FOREIGN KEY (id_workshop) REFERENCES workshop(id_workshop)
);



