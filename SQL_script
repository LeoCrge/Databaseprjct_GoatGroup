create trigger change_review
BEFORE update on review
FOR EACH ROW
BEGIN
	new.reviewdate = localdate.now()
END;

CREATE TRIGGER ValidateEmail
BEFORE INSERT ON communitymember
FOR EACH ROW
BEGIN
	IF NEW.email NOT LIKE '%@%' THEN
    	SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Invalid Email';
    END IF; 
END;

CREATE TRIGGER LogInsert 
AFTER INSERT ON communitymember
FOR EACH ROW 
BEGIN 
INSERT INTO logs (description, date_action) 
VALUES ('New user added: ' || NEW.name, NOW()); 
END;

